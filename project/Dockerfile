# Базовый образ — Python 3.11 на минималистичной Linux-системе
FROM python:3.11-slim

# Рабочая директория внутри контейнера
WORKDIR /app

# Сначала копируем только requirements.txt и устанавливаем зависимости.
# Это отдельный слой — Docker кэширует его. Если код изменится,
# но requirements.txt останется тем же — библиотеки не будут переустанавливаться.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь проект в контейнер
COPY . .

# Порт на котором будет работать сервис
EXPOSE 8000

# Команда запуска сервиса
# --host 0.0.0.0 — слушать все сетевые интерфейсы (нужно для Docker)
# --port 8000    — порт внутри контейнера
CMD ["uvicorn", "src.service.api:app", "--host", "0.0.0.0", "--port", "8000"]
