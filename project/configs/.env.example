# Шаблон конфигурации проекта
# Скопируйте: cp configs/.env.example configs/.env

# Модель для эмбеддингов (sentence-transformers, скачивается автоматически)
MODEL_NAME=all-MiniLM-L6-v2

# Количество результатов поиска по умолчанию
TOP_K=3

# Путь к данным
DATA_DIR=data

# --- Локальная LLM через Ollama (опционально) ---
# Ollama должна быть установлена и запущена: ollama serve
# Поиск работает без Ollama — этот блок не обязателен

# Адрес Ollama (по умолчанию localhost)
OLLAMA_URL=http://localhost:11434

# Модель Ollama (скачать командой: ollama pull qwen2.5:1.5b)
# Рекомендуемые лёгкие модели:
#   qwen2.5:1.5b     (~1 ГБ, хорошее качество на русском)
#   tinyllama        (~640 МБ, очень быстрая)
#   phi3:mini        (~2 ГБ, хорошее качество)
OLLAMA_MODEL=qwen2.5:1.5b
